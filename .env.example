# Copy to .env for local development. Never commit .env.
# Set the same variables in Vercel (Project → Settings → Environment Variables)
# for Production and Preview.

# Resend API key with sending access for danezdalton.com.
RESEND_API_KEY=
# Where contact form messages are delivered.
CONTACT_TO_EMAIL=
# Optional. Defaults to "Dane Dalton's portfolio <contact@danezdalton.com>".
# Use "onboarding@resend.dev" while the domain is still being verified.
# CONTACT_FROM_EMAIL=
