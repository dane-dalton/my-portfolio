---
// Shared page shell: <head>, fonts, global styles and the starfield behind everything.
import Fonts from "../components/Fonts.astro";
import Starfield from "../components/Starfield.astro";
import "../styles/global.css";

interface Props {
  /** Page title. Shown as "Title · Dane Dalton" unless it's already the site name. */
  title?: string;
  description?: string;
  /** Keep the page out of search results (dev and preview pages). */
  noindex?: boolean;
  /** Structured data for search engines, rendered as JSON-LD. */
  jsonLd?: Record<string, unknown>;
}

const siteName = "Dane Dalton";
const {
  title,
  description = "Dane Dalton, software developer in Springfield, IL.",
  noindex = false,
  jsonLd,
} = Astro.props;
const fullTitle =
  title && title !== siteName ? `${title} · ${siteName}` : siteName;

// Absolute URLs for search engines and link previews, based on `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
const ogImageAlt =
  "Dane Dalton, software developer, under a night sky with the Big Dipper and a sunset glow.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a0d1f" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {
      jsonLd && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
    <Fonts />
    <!--
      Runs before first paint. Only when motion is allowed does it mark the page so
      animated elements start hidden; if the animation script hasn't started within
      2.5 seconds, it unhides everything so nothing can stay invisible.
    -->
    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const root = document.documentElement;
        root.classList.add("motion");
        setTimeout(() => {
          if (!("motionReady" in root.dataset)) root.classList.remove("motion");
        }, 2500);
      }
    </script>
  </head>
  <body>
    <Starfield />
    <slot />
    <script>
      import "../scripts/motion";
    </script>
  </body>
</html>
