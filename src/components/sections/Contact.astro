---
// Contact section: a form that emails me through the `contact` action, plus
// my email address with a copy button and my other links.
import { actions } from "astro:actions";
import { contact } from "../../data/contact";
import { links } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";

const fields = [
  {
    name: "name",
    label: "Name",
    type: "text",
    autocomplete: "name",
    required: true,
    maxlength: 100,
  },
  {
    name: "email",
    label: "Email",
    type: "email",
    autocomplete: "email",
    required: true,
    maxlength: 200,
  },
  {
    name: "company",
    label: "Company",
    hint: "Optional",
    type: "text",
    autocomplete: "organization",
    required: false,
    maxlength: 100,
  },
] as const;

const otherLinks = [
  { label: "GitHub", href: links.github },
  { label: "LinkedIn", href: links.linkedin },
  { label: "YouTube", href: links.youtube },
  { label: "Résumé (PDF)", href: links.resume },
];

const inputClass =
  "mt-2 block w-full rounded-lg border border-muted/60 bg-night/70 px-3.5 py-2.5 text-ink focus:border-amber focus:outline-none aria-[invalid=true]:border-rose";
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class="mx-auto max-w-6xl border-t border-dashed border-line px-gutter py-section"
>
  <SectionHeading
    id="contact-heading"
    label={contact.label}
    title={contact.title}
  >
    <p class="mt-2 max-w-[52ch] text-lg font-light text-muted">
      {contact.invitation}
    </p>
  </SectionHeading>

  <div
    class="mt-12 grid gap-12 md:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] lg:gap-16"
  >
    <form
      data-reveal
      method="POST"
      action={"/contact/sent" + actions.contact}
      class="space-y-5"
      data-contact-form
      data-success={contact.success}
      data-error={contact.error}
    >
      {
        fields.map((field) => (
          <div>
            <label for={`contact-${field.name}`} class="text-sm font-medium">
              {field.label}
              {"hint" in field && (
                <span class="ml-1 font-normal text-muted">({field.hint})</span>
              )}
            </label>
            <input
              id={`contact-${field.name}`}
              name={field.name}
              type={field.type}
              autocomplete={field.autocomplete}
              required={field.required}
              maxlength={field.maxlength}
              aria-describedby={`contact-${field.name}-error`}
              class={inputClass}
            />
            <p
              id={`contact-${field.name}-error`}
              class="mt-1.5 text-sm text-rose"
              data-field-error={field.name}
            />
          </div>
        ))
      }

      <div>
        <label for="contact-message" class="text-sm font-medium">Message</label>
        <textarea
          id="contact-message"
          name="message"
          rows="6"
          required
          minlength="10"
          maxlength="5000"
          aria-describedby="contact-message-error"
          class:list={[inputClass, "resize-y"]}></textarea>
        <p
          id="contact-message-error"
          class="mt-1.5 text-sm text-rose"
          data-field-error="message"
        >
        </p>
      </div>

      <!-- Spam traps: a field people never see, and how long the form was open. -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label for="contact-website">Leave this field empty</label>
        <input
          id="contact-website"
          name="website"
          type="text"
          tabindex="-1"
          autocomplete="off"
        />
      </div>
      <input type="hidden" name="elapsed" value="" data-elapsed />

      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 pt-1">
        <button
          type="submit"
          class="button-sunset px-6 py-2.5 text-sm disabled:cursor-wait disabled:opacity-70"
          data-submit
        >
          Send message
        </button>
        <p role="status" aria-live="polite" class="text-sm" data-status></p>
      </div>
    </form>

    <aside aria-label="Other ways to reach me" class="space-y-8" data-reveal>
      <div>
        <p class="font-mono text-label text-muted uppercase">Email</p>
        <p class="mt-2 font-mono text-lg break-all select-all sm:text-xl">
          <a href={`mailto:${links.email}`} data-email>{links.email}</a>
        </p>
        <button
          type="button"
          class="mt-3 rounded-full border border-line px-3.5 py-1.5 font-mono text-label text-ink uppercase transition-colors hover:border-amber"
          data-copy-email={links.email}
        >
          Copy email
        </button>
        <span class="sr-only" aria-live="polite" data-copy-status></span>
      </div>

      <div>
        <p class="font-mono text-label text-muted uppercase">Elsewhere</p>
        <ul class="mt-3 space-y-2">
          {
            otherLinks.map(({ label, href }) => (
              <li>
                <a href={href} target="_blank" rel="noopener" class="link-line">
                  {label} <span aria-hidden="true">↗</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </aside>
  </div>
</section>

<script>
  import { actions, isInputError } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]")!;
    const elapsed = form.querySelector<HTMLInputElement>("[data-elapsed]")!;
    const openedAt = performance.now();

    const clearErrors = () => {
      for (const el of form.querySelectorAll<HTMLElement>(
        "[data-field-error]",
      )) {
        el.textContent = "";
      }
      for (const el of form.querySelectorAll("[aria-invalid]")) {
        el.removeAttribute("aria-invalid");
      }
    };

    const showStatus = (text: string, tone: "ok" | "error") => {
      status.textContent = text;
      status.classList.toggle("text-signal", tone === "ok");
      status.classList.toggle("text-rose", tone === "error");
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      clearErrors();
      elapsed.value = String(Math.round(performance.now() - openedAt));
      submit.disabled = true;
      submit.textContent = "Sending…";
      showStatus("", "ok");

      const { error } = await actions.contact(new FormData(form));

      submit.disabled = false;
      submit.textContent = "Send message";

      if (!error) {
        form.reset();
        showStatus(form.dataset.success ?? "", "ok");
        return;
      }

      if (isInputError(error)) {
        let first: HTMLElement | null = null;
        for (const [name, messages] of Object.entries(error.fields)) {
          const input = form.elements.namedItem(name);
          const message = form.querySelector<HTMLElement>(
            `[data-field-error="${name}"]`,
          );
          if (!(input instanceof HTMLElement) || !message) continue;
          input.setAttribute("aria-invalid", "true");
          message.textContent = messages?.[0] ?? "";
          first ??= input;
        }
        showStatus("Please fix the highlighted fields.", "error");
        first?.focus();
        return;
      }

      showStatus(form.dataset.error ?? "", "error");
    });
  }

  // Copy email, falling back to selecting the address if the clipboard is blocked.
  const copyButton =
    document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");
  const emailLink = document.querySelector<HTMLElement>("[data-email]");

  copyButton?.addEventListener("click", async () => {
    const address = copyButton.dataset.copyEmail ?? "";
    let copied = false;
    try {
      await navigator.clipboard.writeText(address);
      copied = true;
    } catch {
      if (emailLink) {
        const range = document.createRange();
        range.selectNodeContents(emailLink);
        const selection = getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
      }
    }
    copyButton.textContent = copied ? "Copied" : "Press Ctrl+C to copy";
    if (copyStatus) {
      copyStatus.textContent = copied
        ? "Email address copied."
        : "Email address selected.";
    }
    setTimeout(() => {
      copyButton.textContent = "Copy email";
    }, 2000);
  });
</script>
