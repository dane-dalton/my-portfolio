---
// About section: bio, headshot, skills and the climbing note.
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import photo from "../../assets/photoOfMe.png";
import { about, skillGroups } from "../../data/about";
import { links } from "../../data/site";
import SectionHeading from "../SectionHeading.astro";
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="mx-auto max-w-6xl border-t border-dashed border-line px-gutter py-section"
>
  <SectionHeading id="about-heading" label={about.label} title={about.title}>
    <p class="mt-2 text-lg font-light text-muted">{about.subtitle}</p>
  </SectionHeading>

  <div
    class="mt-12 grid items-start gap-12 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:gap-16"
  >
    <figure class="mx-auto w-48 md:mx-0 md:w-full" data-reveal>
      <div class="relative">
        <!-- Dashed "orbit" ring with a single amber star on it. -->
        <div
          aria-hidden="true"
          class="absolute -inset-3 rounded-full border border-dashed border-amber/40"
        >
          <span
            class="absolute top-[14%] right-[6%] size-2 rounded-full bg-amber shadow-[0_0_10px_var(--color-amber)]"
          ></span>
        </div>
        <Image
          src={photo}
          alt={about.photoAlt}
          width={480}
          widths={[192, 240, 384, 480]}
          sizes="(min-width: 768px) 240px, 192px"
          class="aspect-square w-full rounded-full bg-[radial-gradient(circle_at_50%_30%,var(--color-night-glow),var(--color-night)_75%)] object-cover object-top"
        />
      </div>
      <figcaption
        class="mt-6 text-center font-mono text-label text-muted uppercase md:text-left"
      >
        Fig. 1 · Dane Dalton
      </figcaption>
    </figure>

    <div class="max-w-[65ch] space-y-5 leading-relaxed" data-reveal>
      {about.bio.map((paragraph) => <p>{paragraph}</p>)}
      <p class="text-muted">
        {about.climbing}{" "}
        <a
          href={links.youtube}
          target="_blank"
          rel="noopener"
          class="link-inline"
        >
          {about.climbingLinkText}
          <span aria-hidden="true">↗</span>
          <span class="sr-only">(opens in a new tab)</span>
        </a>.
      </p>
    </div>
  </div>

  <div class="mt-16">
    <h3 class="font-mono text-label text-muted uppercase" data-reveal>
      Skills
    </h3>
    <div class="mt-6 grid gap-x-10 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
      {
        skillGroups.map((group) => (
          <div data-reveal>
            <h4 class="font-display text-xl">{group.title}</h4>
            <ul class="mt-3 flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <li class="inline-flex items-center gap-1.5 rounded-full border border-line px-2.5 py-1 text-sm text-ink/90">
                  {skill.icon ? (
                    <Icon
                      name={`simple-icons:${skill.icon}`}
                      class="size-3.5 shrink-0 text-muted"
                      aria-hidden="true"
                    />
                  ) : (
                    <span aria-hidden="true" class="text-xs text-amber">
                      ✦
                    </span>
                  )}
                  {skill.name}
                </li>
              ))}
            </ul>
            {group.note && <p class="mt-2 text-sm text-muted">{group.note}</p>}
          </div>
        ))
      }
    </div>
  </div>
</section>
