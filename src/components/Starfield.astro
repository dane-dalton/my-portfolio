---
// Full-viewport twinkling night sky, fixed behind the page content.
interface Props {
  /** Stars per square pixel of viewport. */
  density?: number;
  /** Upper limit on stars, so huge screens stay cheap to draw. */
  maxStars?: number;
}

const { density = 0.00025, maxStars = 700 } = Astro.props;
---

<canvas
  data-starfield
  data-density={density}
  data-max-stars={maxStars}
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 -z-10 h-full w-full bg-[radial-gradient(110%_70%_at_80%_0%,var(--color-night-glow),var(--color-night)_60%)]"
></canvas>

<script>
  interface Star {
    x: number;
    y: number;
    radius: number;
    phase: number;
    speed: number;
    warm: boolean;
  }

  const FRAME_MS = 1000 / 30;
  const WARM_SHARE = 0.06;

  function startStarfield(canvas: HTMLCanvasElement) {
    const context = canvas.getContext("2d");
    if (!context) return;
    const ctx = context;

    const density = Number(canvas.dataset.density);
    const maxStars = Number(canvas.dataset.maxStars);
    const styles = getComputedStyle(document.documentElement);
    const coolColor = styles.getPropertyValue("--color-ink").trim();
    const warmColor = styles.getPropertyValue("--color-amber").trim();
    const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

    let stars: Star[] = [];
    let width = 0;
    let height = 0;
    let frameId = 0;
    let lastFrame = 0;

    function resize() {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      width = canvas.clientWidth;
      height = canvas.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      const count = Math.min(maxStars, Math.round(width * height * density));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        radius: 0.3 + Math.random() ** 2 * 1.2,
        phase: Math.random() * Math.PI * 2,
        speed: 0.4 + Math.random() * 1.4,
        warm: Math.random() < WARM_SHARE,
      }));
      draw(performance.now());
    }

    function draw(time: number) {
      ctx.clearRect(0, 0, width, height);
      const still = reducedMotion.matches;
      for (const star of stars) {
        const twinkle = still
          ? 0.75
          : 0.35 +
            0.65 *
              (0.5 + 0.5 * Math.sin(star.phase + (time / 1000) * star.speed));
        ctx.fillStyle = star.warm ? warmColor : coolColor;
        ctx.globalAlpha = twinkle;
        ctx.beginPath();
        ctx.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
        ctx.fill();
        // Soft halo on the brightest stars, cheaper than a canvas shadow.
        if (star.radius > 1.1) {
          ctx.globalAlpha = twinkle * 0.15;
          ctx.beginPath();
          ctx.arc(star.x, star.y, star.radius * 3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.globalAlpha = 1;
    }

    function tick(time: number) {
      frameId = requestAnimationFrame(tick);
      if (time - lastFrame < FRAME_MS) return;
      lastFrame = time;
      draw(time);
    }

    function start() {
      cancelAnimationFrame(frameId);
      if (reducedMotion.matches || document.hidden) {
        draw(performance.now());
        return;
      }
      frameId = requestAnimationFrame(tick);
    }

    let resizeTimer = 0;
    window.addEventListener("resize", () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 150);
    });
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) cancelAnimationFrame(frameId);
      else start();
    });
    reducedMotion.addEventListener("change", start);

    resize();
    start();
  }

  document
    .querySelectorAll<HTMLCanvasElement>("canvas[data-starfield]")
    .forEach(startStarfield);
</script>
