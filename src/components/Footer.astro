---
// Site footer. The year is set when the site is built.
const repo = "https://github.com/dane-dalton/my-portfolio";
---

<footer
  class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-dashed border-line px-gutter py-8 font-mono text-label text-muted"
>
  <p>© {new Date().getFullYear()} Dane Dalton</p>
  <p>
    Built with Astro and Tailwind CSS ·
    <a
      href={repo}
      target="_blank"
      rel="noopener"
      class="text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-amber"
    >
      Source on GitHub<span class="sr-only"> (opens in a new tab)</span>
    </a>
  </p>
</footer>
